    {
      "type": "timeseries",
      "title": "Sync dispatcher queue latency",
      "description": "P50/P95/P99 of observed operations; no observations produce no data/NaN. Check the stage's observation rate. Quantiles from different stages cannot be added or subtracted. Values above the largest finite histogram bucket cannot be resolved accurately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "expr": "histogram_quantile(0.5, sum by (le,pod) (rate(milvus_wal_flusher_sync_dispatcher_queue_duration_seconds_bucket{cluster=\"$cluster\",namespace=\"$namespace\",woodpecker_id=\"$woodpecker_id\",component=\"streamingnode\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P50 · {{pod}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "expr": "histogram_quantile(0.95, sum by (le,pod) (rate(milvus_wal_flusher_sync_dispatcher_queue_duration_seconds_bucket{cluster=\"$cluster\",namespace=\"$namespace\",woodpecker_id=\"$woodpecker_id\",component=\"streamingnode\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P95 · {{pod}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true,
          "expr": "histogram_quantile(0.99, sum by (le,pod) (rate(milvus_wal_flusher_sync_dispatcher_queue_duration_seconds_bucket{cluster=\"$cluster\",namespace=\"$namespace\",woodpecker_id=\"$woodpecker_id\",component=\"streamingnode\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P99 · {{pod}}"
        }
      ],
